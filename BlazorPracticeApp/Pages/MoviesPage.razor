@page "/movies"
@using BlazorPracticeApp.ApiRequest
@using BlazorPracticeApp.ApiRequest.Models
@inject ApiRequest Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h2 class="movies-title">Кино дайджест</h2>

<div class="movies-layout">
    <section class="movies-filters">
        <div class="filter-group">
            <label>Поиск</label>
            <input @bind="searchTerm" placeholder="Название или описание" />
        </div>

        <div class="filter-group">
            <label>Жанр</label>
            <select @bind="selectedGenre">
                <option value="">Все жанры</option>
                @foreach (var genre in GetGenres())
                {
                    <option value="@genre">@genre</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Сортировка</label>
            <select @bind="sortOption">
                <option value="name">По названию (A–Z)</option>
                <option value="rating_desc">По рейтингу (убывание)</option>
                <option value="rating_asc">По рейтингу (возрастание)</option>
                <option value="date_desc">По дате выхода (новые)</option>
                <option value="date_asc">По дате выхода (старые)</option>
            </select>
        </div>

        <button class="btn-primary"
                type="button"
                @onclick="GoToCreateMovie"
                disabled="@(!isAdmin)"
                title="Доступно только администратору">
            Добавить фильм
        </button>


    </section>

    <section class="movies-cards-shell">
        @if (movies == null)
        {
            <p class="movies-cards__empty">Загрузка...</p>
        }
        else if (!GetFilteredMovies().Any())
        {
            <p class="movies-cards__empty">Фильмы не найдены</p>
        }
        else
        {
            <div class="movies-cards-grid">
                @foreach (var movie in GetFilteredMovies())
                {
                    <button type="button"
                            class="movie-card"
                            @onclick="() => OpenDetails(movie.Id)">
                        <span class="movie-card__poster">
                            <MoviePoster ImageUrl="@movie.ImageUrl"
                                         Alt=""
                                         CssClass="movie-card__thumb"
                                         Width="200"
                                         Height="300" />
                        </span>
                        <span class="movie-card__body">
                            <span class="movie-card__title" title="@movie.Name">@movie.Name</span>
                            @if (!string.IsNullOrWhiteSpace(movie.Genre))
                            {
                                <span class="movie-card__genre">@movie.Genre</span>
                            }
                            <span class="movie-card__meta">
                                <span class="movie-card__date">@movie.ReleaseDate.ToString("dd.MM.yyyy")</span>
                                <span class="movie-card__rating">@movie.Rating</span>
                            </span>
                        </span>
                    </button>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<Movie>? movies;
    private string? searchTerm;
    private string? selectedGenre;
    private string sortOption = "date_desc";
    private bool isAdmin;

    private List<string> GetGenres()
    {
        if (movies == null)
        {
            return new List<string>();
        }

        return movies.Where(m => !string.IsNullOrWhiteSpace(m.Genre)).Select(m => m.Genre!).Distinct().OrderBy(g => g).ToList();
    }

    private List<Movie> GetFilteredMovies()
    {
        if (movies == null)
        {
            return new List<Movie>();
        }

        var result = movies.ToList();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLower();

            result = result.Where(m => (!string.IsNullOrEmpty(m.Name) && m.Name.ToLower().Contains(term)) || (!string.IsNullOrEmpty(m.Description) && m.Description.ToLower().Contains(term))).ToList();
        }

        if (!string.IsNullOrWhiteSpace(selectedGenre))
        {
            var genre = selectedGenre.Trim().ToLower();

            result = result.Where(m =>!string.IsNullOrWhiteSpace(m.Genre) && m.Genre!.Trim().ToLower() == genre).ToList();
        }

        if (sortOption == "name")
        {
            result = result.OrderBy(m => m.Name).ToList();
        }
        else if (sortOption == "rating_desc")
        {
            result = result.OrderByDescending(m => m.Rating).ToList();
        }
        else if (sortOption == "rating_asc")
        {
            result = result.OrderBy(m => m.Rating).ToList();
        }
        else if (sortOption == "date_asc")
        {
            result = result.OrderBy(m => m.ReleaseDate).ToList();
        }
        else
        {
            result = result.OrderByDescending(m => m.ReleaseDate).ToList();
        }

        return result;
    }

    protected override async Task OnInitializedAsync()
    {
        var role = await JS.InvokeAsync<string>("sessionStorage.getItem", "role");
        isAdmin = role == "1";

        var result = await Api.GetMovies();
        movies = result.list ?? new List<Movie>();
    }

    private void OpenDetails(int id)
    {
        Navigation.NavigateTo($"/movies/{id}");
    }

    private void GoToCreateMovie()
    {
        if (!isAdmin)
        {
            return;
        }

        Navigation.NavigateTo("/movies/new");
    }
}

<style>
    .movies-title {
        margin: 0 0 14px;
        font-size: 24px;
        font-weight: 600;
        color: #0b3d2e;
    }

    .movies-layout {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .movies-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 16px;
        padding: 10px 12px;
        border-radius: 16px;
        background: radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.16), transparent 55%), linear-gradient(135deg, #020617, #020617);
        border: 1px solid rgba(31, 41, 55, 0.95);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 180px;
        flex: 1;
    }

        .filter-group label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #9ca3af;
        }

        .filter-group input,
        .filter-group select {
            padding: 8px 10px;
            border-radius: 10px;
            border: 1px solid rgba(55, 65, 81, 0.95);
            background-color: #020617;
            color: #e5e7eb;
            font-size: 13px;
        }

    .movies-cards-shell {
        border-radius: 18px;
        background: radial-gradient(circle at 0% 0%, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
        border: 1px solid rgba(31, 41, 55, 0.95);
        padding: 16px 14px 18px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.95);
    }

    .movies-cards__empty {
        margin: 0;
        padding: 28px 12px;
        text-align: center;
        font-size: 14px;
        color: #9ca3af;
    }

    .movies-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
        gap: 16px;
    }

    .movie-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 0;
        margin: 0;
        font: inherit;
        text-align: inherit;
        color: inherit;
        appearance: none;
        -webkit-appearance: none;
        border-radius: 14px;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(15, 23, 42, 0.92), rgba(17, 24, 39, 0.98));
        border: 1px solid rgba(55, 65, 81, 0.85);
        cursor: pointer;
        transition: transform 0.14s ease, box-shadow 0.18s ease, border-color 0.14s ease;
    }

        .movie-card:hover,
        .movie-card:focus-visible {
            transform: translateY(-3px);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.65);
            border-color: rgba(56, 189, 248, 0.55);
        }

        .movie-card:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.65), 0 16px 40px rgba(0, 0, 0, 0.55);
        }

    .movie-card__poster {
        display: block;
        aspect-ratio: 2 / 3;
        background: #0f172a;
    }

    .movie-card__thumb {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
        border: 0;
    }

    .movie-card__body {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 10px 11px 12px;
        min-height: 0;
        text-align: start;
    }

    .movie-card__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 14px;
        font-weight: 600;
        color: #f9fafb;
        line-height: 1.3;
    }

    .movie-card__genre {
        align-self: flex-start;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #7dd3fc;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
    }

    .movie-card__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 2px;
        width: 100%;
        font-size: 12px;
        color: #9ca3af;
    }

    .movie-card__rating {
        font-weight: 700;
        color: #fde68a;
        font-variant-numeric: tabular-nums;
    }

    .btn-primary {
        padding: 9px 16px;
        border-radius: 999px;
        border: 1px solid rgba(34, 197, 94, 0.95);
        background: radial-gradient(circle at 0% 0%, rgba(34, 197, 94, 0.85) 0, transparent 60%), linear-gradient(135deg, #0b3d2e, #16a34a 40%, #22c55e 100%);
        color: #ecfdf5;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 0 18px 40px rgba(5, 46, 22, 0.9), 0 0 0 2px rgba(2, 6, 23, 0.9);
        transition: transform 0.12s ease, box-shadow 0.18s ease, filter 0.12s ease;
        white-space: nowrap;
    }

        .btn-primary:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
            box-shadow: 0 22px 56px rgba(6, 78, 59, 0.95), 0 0 0 2px rgba(34, 197, 94, 0.95);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 10px 26px rgba(6, 78, 59, 0.9), 0 0 0 2px rgba(21, 128, 61, 0.95);
        }

        .btn-primary:disabled {
            cursor: not-allowed;
            filter: none;
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.22), rgba(34, 197, 94, 0.12));
            color: rgba(236, 253, 245, 0.7);
            border-color: rgba(34, 197, 94, 0.35);
            box-shadow: none;
            transform: none;
        }
</style>
