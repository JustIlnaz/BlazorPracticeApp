@page "/chat/private/{PeerId:int}"
@inject NavigationManager Nav

<div class="chat-page">
    <div class="chat-page__head">
        <h2 class="chat-page__title">Личный чат</h2>
        <p class="chat-page__sub">Переписка с пользователем #@PeerId</p>
        <div class="chat-page__nav">
            <button type="button" class="linkish" @onclick='() => Nav.NavigateTo("/chat")'>Назад к чатам</button>
            <button type="button" class="linkish" @onclick='() => Nav.NavigateTo("/user")'>Профиль</button>
        </div>
    </div>

    <ChatConversation PeerUserId="PeerId" />
</div>

@code {
    [Parameter] public int PeerId { get; set; }
}

<style>
    .chat-page {
        max-width: 720px;
        margin: 0 auto;
    }

    .chat-page__head {
        margin-bottom: 16px;
    }

    .chat-page__title {
        margin: 0 0 4px;
        font-size: 22px;
        color: #0b3d2e;
    }

    .chat-page__sub {
        margin: 0 0 10px;
        font-size: 15px;
        color: #374151;
    }

    .chat-page__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
    }

    .linkish {
        border: 0;
        background: none;
        padding: 0;
        color: #047857;
        text-decoration: underline;
        cursor: pointer;
        font-size: 13px;
    }
</style>
